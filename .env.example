# Copy this file to .env.local and fill in the keys you have.
# The app runs with none of them; each key switches one part from "stand-in" to "real".
# Never commit .env.local (it is in .gitignore).

# Main AI: traces the ripple. Free key from console.groq.com.
GROQ_API_KEY=
# Change this if the model name has been retired.
GROQ_MODEL=openai/gpt-oss-120b

# Optional backup AIs, tried in this order when Groq fails or runs out of free requests.
# One NVIDIA key (build.nvidia.com) works for every model there.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
DEEPSEEK_API_KEY=

# Talk to the map (full-screen map): hears your question and reads the answer out loud.
# Key from elevenlabs.io with Text to Speech, Speech to Text and Voices: Read switched on.
ELEVENLABS_API_KEY=
# The voice to speak in. Leave both empty for the account voice named "Hope".
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=
# After "Hey Windy" it says "Hey <name>, what information would you like?". The name comes
# from the account's email, or from here for a guest.
VOICE_GREETING_NAME=

# Stock, fund and bond-fund prices. Free key from twelvedata.com.
TWELVEDATA_API_KEY=

# Optional: live web news search with sources. Without it, news comes from
# Wikipedia's daily world-events page.
PERPLEXITY_API_KEY=

# Tiger Data (Postgres) connection string. Without it, history is kept in memory
# and lost on restart.
DATABASE_URL=

# Sent to weather.gov and Wikipedia so they know who is calling.
CONTACT_EMAIL=ansh.rao.152@gmail.com

# Solana devnet wallet that stamps each answer's fingerprint on-chain (test network, no real
# money). Base64 of the wallet's 64-byte secret key. Without it, answers are not stamped.
SOLANA_SECRET_KEY=

# Alpha Vantage: oil and natural gas prices. Free plan: 25 requests a day.
ALPHAVANTAGE_API_KEY=

# Financial Modeling Prep: analyst ratings for some companies, and the gold price.
# Free plan: 250 requests a day, and only some companies are covered.
FMP_API_KEY=
